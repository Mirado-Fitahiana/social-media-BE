@page
@model social_media_BE.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-container d-flex justify-content-center align-items-center">
    <div class="login-card shadow-lg p-4">
        <h2 class="text-center mb-4 login-title">Welcome Back</h2>
        <p class="text-center text-muted mb-4">Sign in to continue</p>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success text-center">@Model.SuccessMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label fw-semibold"></label>
                <input asp-for="Input.Username" class="form-control custom-input" />
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                <input asp-for="Input.Password" class="form-control custom-input" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <input type="hidden" asp-for="ReturnUrl" />

            <button type="submit" class="btn btn-primary w-100 login-btn">Sign in</button>
        </form>

        <div class="text-center mt-3">
            <a href="/Account/Register" class="create-account-link">Create an account</a>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
